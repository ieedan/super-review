{
	"name": "super-review",
	"version": "0.0.1",
	"description": "A faster, saner desktop UI for reviewing agent-written code",
	"type": "module",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "pnpm --filter @super-review/desktop dev",
		"build": "pnpm --filter @super-review/desktop build",
		"preview": "pnpm --filter @super-review/desktop preview",
		"start": "pnpm --filter @super-review/desktop start",
		"package": "pnpm --filter @super-review/desktop package",
		"package:dir": "pnpm --filter @super-review/desktop package:dir",
		"release": "pnpm --filter @super-review/desktop release",
		"typecheck": "pnpm -r typecheck",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.32.1",
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.16.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.16.6",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.58.0"
	}
}
