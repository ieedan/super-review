# This file describes the LOCAL SvelteKit env (.env.local), written by
# `pnpm setup:dev`. In production the same server-side values live in the Vercel
# project env instead, plus CONVEX_DEPLOY_KEY so the build can push the Convex
# functions; `pnpm setup:prod` sets all of it up. See ./README.md#deploying.

# Deployment used by `npx convex dev` (written by the Convex CLI on first run).
CONVEX_DEPLOYMENT=

# Convex deployment URLs (patched by `convex dev` / vercel:deploy).
# PUBLIC_CONVEX_SITE_URL is the same deployment with .convex.site — the
# better-auth SvelteKit handler proxies auth routes to it at build time.
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=

# Shared secret authorizing SvelteKit -> Convex internal function calls.
# Must be set to the SAME value in the Convex deployment env.
FUNCTION_SECRET=

# Ed25519 signing key for desktop license tokens (base64 PKCS#8).
# Generate locally with scripts/generate-license-keys.mjs; never commit.
ED25519_PRIVATE_KEY=
ED25519_KID=

# Salt for hashing client IPs before they reach Convex (abuse detection).
IP_HASH_SALT=

# Fine-grained GitHub PAT with `Contents: read` on the releases repo. Lets
# /api/download resolve release assets while the repo stays private.
GITHUB_RELEASES_TOKEN=

# ISO date the $100 lifetime launch deal closes (also set in the Convex env).
LAUNCH_CUTOFF=2026-08-17

# Same value, exposed to the client so the homepage pricing can show/hide the
# lifetime option. Keep it identical to LAUNCH_CUTOFF.
PUBLIC_LAUNCH_CUTOFF=2026-08-17

# The following are set in the CONVEX deployment env (npx convex env set ...),
# NOT in this SvelteKit .env, but are listed here for reference:
#   BETTER_AUTH_SECRET, SITE_URL, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
#   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#   STRIPE_PRICE_MONTHLY, STRIPE_PRICE_ANNUAL, STRIPE_PRICE_LIFETIME,
#   LAUNCH_CUTOFF (ISO date), TRIAL_DAYS, IP_HASH_SALT, FUNCTION_SECRET

# In-app feedback -> Discord. Both live in the CONVEX deployment env, not here,
# and both are prompted for by `pnpm setup:dev`:
#   FEEDBACK_BOT_TOKEN     Bot token. The bot posts each report and opens a
#                          thread on it. A bot rather than a channel webhook
#                          because opening a thread on a message only works with
#                          a bot token, and once you need one for that it may as
#                          well post the message too. Needs View Channels, Send
#                          Messages, Embed Links, Create Public Threads.
#   FEEDBACK_CHANNEL_ID    Channel the reports go to. Right-click the channel >
#                          Copy Channel ID (needs Developer Mode on).
# Both optional: with either unset, feedback is still stored in the `feedback`
# table, it is just logged to the Convex console instead of posted.

# Loops (https://loops.so) for the beta emails. All live in the CONVEX
# deployment env, not here:
#   LOOPS_API_KEY                           API key from Loops settings.
#   LOOPS_WAITLIST_TRANSACTIONAL_ID         "You're on the waitlist".
#                                           Vars: {data.waitlistUrl}
#   LOOPS_INVITE_TRANSACTIONAL_ID           "Here's your invite code".
#                                           Vars: {data.code}, {data.redeemUrl}
#   LOOPS_GUEST_INVITE_TRANSACTIONAL_ID     "A friend invited you".
#                                           Vars: {data.code}, {data.redeemUrl},
#                                           {data.inviterName}
#   LOOPS_REFERRAL_REWARD_TRANSACTIONAL_ID  "You earned 15% off", sent when all of
#                                           a member's guest codes are redeemed.
#                                           Vars: {data.percentOff},
#                                           {data.pricingUrl}
#
# Redemption sends nothing: the invite email is the welcome, and by the time a
# code is redeemed the reader is already on the dashboard.
#
# Template variables are referenced in LMX as {data.x}, not {x}.
# All optional and independent: an unset template id means that one email is
# logged to the Convex console instead of sent, so local dev needs no Loops
# account. `pnpm setup:dev` prompts for all of them.

# Stripe coupon for the referral reward (15% off, duration Once), applied at
# checkout for members who got all their guest invites redeemed. Lives in the
# CONVEX deployment env. Keep its percentage in step with
# REFERRAL_DISCOUNT_PERCENT in src/lib/convex/invites.ts.
#   STRIPE_REFERRAL_COUPON_ID
