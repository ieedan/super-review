{
	"name": "@super-review/web",
	"description": "Marketing site, licensing backend, and account dashboard for Super Review",
	"private": true,
	"version": "0.0.13",
	"type": "module",
	"scripts": {
		"dev": "dotenvx run -f .env.local -- concurrently -n convex,app -c blue,green \"pnpm dev:convex\" \"pnpm dev:vite\"",
		"dev:vite": "vite dev",
		"dev:convex": "convex dev",
		"build": "vite build",
		"preview": "vite preview",
		"vercel:deploy": "CONVEX_VERBOSE=1 convex deploy --cmd-url-env-var-name PUBLIC_CONVEX_URL --cmd='sed -i.bak \"s|{{CONVEX_URL_FROM_CLI}}|${PUBLIC_CONVEX_URL}|\" src/lib/env.server.ts && rm -f src/lib/env.server.ts.bak && pnpm build'",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"setup:dev": "node scripts/setup-dev.mjs",
		"reset:db": "dotenvx run -f .env.local -- node scripts/reset-db.mjs",
		"stripe:listen": "node scripts/stripe-listen.mjs"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "2.1.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"concurrently": "^10.0.3",
		"shadcn-svelte": "^1.3.0",
		"svelte": "catalog:",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.7.3",
		"vite": "^8.0.7",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@better-auth/stripe": "1.6.23",
		"@convex-dev/better-auth": "0.12.5",
		"@convex-dev/rate-limiter": "^0.3.2",
		"@ethercorps/sveltekit-og": "^4.3.0",
		"@iconify/svelte": "^5.2.1",
		"@lucide/svelte": "^1.17.0",
		"@mmailaender/convex-better-auth-svelte": "^0.8.1",
		"@super-review/core": "workspace:*",
		"@super-review/ui": "workspace:*",
		"@t3-oss/env-core": "^0.13.11",
		"better-auth": "^1.6.23",
		"bits-ui": "^2.18.1",
		"convex": "^1.42.1",
		"convex-helpers": "^0.1.120",
		"convex-svelte": "^0.14.0",
		"errf": "^0.1.2",
		"jose": "^6.0.0",
		"nevereverthrow": "^0.3.0",
		"stripe": "^22.3.2",
		"zod": "^4.4.3"
	}
}
