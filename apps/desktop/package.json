{
	"name": "@super-review/desktop",
	"version": "0.5.2",
	"description": "A faster, saner desktop UI for reviewing agent-written code",
	"main": "out/main/index.js",
	"type": "module",
	"private": true,
	"author": "",
	"license": "MIT",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"start": "electron-vite preview",
		"package": "electron-vite build && electron-builder",
		"package:dir": "electron-vite build && electron-builder --dir",
		"release": "electron-vite build && electron-builder --publish always",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json",
		"typecheck:web": "svelte-check --tsconfig tsconfig.web.json",
		"typecheck": "pnpm typecheck:node && pnpm typecheck:web"
	},
	"dependencies": {
		"@fontsource/geist-sans": "^5.2.5",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@libsql/client": "^0.17.3",
		"@octokit/auth-oauth-device": "^7.1.3",
		"@octokit/rest": "^21.0.2",
		"@super-review/core": "workspace:*",
		"@super-review/ui": "workspace:*",
		"convex": "^1.42.2",
		"drizzle-orm": "^0.45.2",
		"electron-store": "^10.0.1",
		"electron-updater": "^6.6.2",
		"fix-path": "^4.0.0",
		"ignore": "^7.0.5",
		"marked": "^18.0.4",
		"simple-git": "^3.27.0",
		"sv-agentation": "catalog:",
		"tw-animate-css": "^1.4.0",
		"ws": "^8.18.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@electron/fuses": "^1.8.0",
		"@lucide/svelte": "^1.17.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.1.7",
		"@tsconfig/svelte": "^5.0.4",
		"@types/node": "^24.0.0",
		"@types/ws": "^8.5.12",
		"autoprefixer": "^10.4.20",
		"electron": "^33.3.1",
		"electron-builder": "^25.1.8",
		"electron-vite": "^5.0.0",
		"paneforge": "^1.0.2",
		"shadcn-svelte": "^1.3.0",
		"svelte": "catalog:",
		"svelte-check": "^4.1.4",
		"tailwindcss": "^4.1.7",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3",
		"vite": "^6.0.7"
	}
}
