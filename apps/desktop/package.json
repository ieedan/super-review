{
  "name": "@super-local-review/desktop",
  "version": "0.0.1",
  "description": "A faster, saner desktop UI for reviewing agent-written code",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "svelte-check --tsconfig tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "format": "prettier --write src",
    "lint": "eslint . --ext .ts,.svelte"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.7",
    "@iconify-json/material-icon-theme": "^1.2.66",
    "@iconify/svelte": "^5.2.1",
    "@octokit/auth-oauth-device": "^7.1.3",
    "@octokit/rest": "^21.0.2",
    "@pierre/diffs": "^1.2.3",
    "dompurify": "^3.4.7",
    "electron-store": "^10.0.1",
    "ignore": "^7.0.5",
    "marked": "^18.0.4",
    "runed": "^0.37.1",
    "simple-git": "^3.27.0",
    "svelte-tiny-virtual-list": "^3.0.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.17.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.7",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.10.5",
    "autoprefixer": "^10.4.20",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "lucide-svelte": "^0.474.0",
    "mode-watcher": "^0.5.1",
    "paneforge": "^1.0.2",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "shadcn-svelte": "^1.3.0",
    "svelte": "^5.16.6",
    "svelte-check": "^4.1.4",
    "tailwind-merge": "^2.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.7",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
